# 아래 값은 담당 기능 구현 시 사용합니다. 현재 /health 실행에는 필요하지 않습니다.
# 실제 비밀값은 로컬 .env 또는 Railway 환경 변수에서만 설정합니다.

# 세션 쿠키 서명용 비밀값
SECRET_KEY=
# SQLAlchemy DB 연결 URL (로컬/배포 경로 구분)
DATABASE_URL=
# FastAPI 서버에서만 사용하는 Gemini API Key
GEMINI_API_KEY=
# Gemini 모델 이름
GEMINI_MODEL=gemini-3.5-flash-lite
# AI 요청 제한 시간(초)
AI_TIMEOUT=30
