# 세션 쿠키 서명용 비밀값
SECRET_KEY=
# HTTPS 전용 세션 쿠키 사용 여부 (로컬 HTTP: false, Railway HTTPS: true)
SESSION_HTTPS_ONLY=false
# SQLAlchemy DB 연결 URL (로컬/배포 경로 구분)
DATABASE_URL=
# FastAPI 서버에서만 사용하는 Codyssey virtual key
CODYSSEY_API_KEY=
# Codyssey Chat Completions API URL
AI_API_URL=
# AI 모델 이름
AI_MODEL=
# AI 요청 제한 시간(초)
AI_TIMEOUT=
